{
  "name": "drive-notes",
  "private": true,
  "description": "Drive Notes: PWA pessoal de notas em markdown no Google Drive. Este package.json existe só para os testes; o app não tem build.",
  "scripts": {
    "test": "node tests/app.test.js",
    "test:browser": "node tests/browser.test.js",
    "test:sw": "node tests/sw.test.js",
    "test:all": "node tests/app.test.js && node tests/browser.test.js && node tests/sw.test.js",
    "screenshots": "node tests/screenshots.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "dompurify": "3.2.6",
    "esbuild": "0.24.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "marked": "15.0.7",
    "tiny-markdown-editor": "0.1.8"
  }
}
